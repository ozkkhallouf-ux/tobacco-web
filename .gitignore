# Runtime
*.log
*.pid
reports/prices/*.csv
tools/.env
tools/logs/

# Python cache from ios-sideload lab
ios-sideload-lab/__pycache__/

# مسودات ونسخ احتياطية مؤقتة — لا تدخل Git
tmp/
*.bak
*.bak[0-9]

# Supabase CLI local state
supabase/.temp/

# ─── PrintBridge / ameen-autoprint runtime artifacts — لا تدخل Git أبداً ────
# ملفات الحالة (GUIDs المطبوعة) وسجلات الأحداث الخاصة بأي جهاز
tools/ameen-autoprint/last-printed.json
tools/ameen-autoprint/state.json
tools/ameen-autoprint/logs/
ozk-print-bridge/state.json
ozk-print-bridge/logs/
**/PrintBridge/state.json
**/PrintBridge/logs/
# نسخ الـwrapper المولّدة فعلياً (المولِّد نفسه source ويبقى؛ الناتج فقط يُستبعد)
ozk-print-bridge/install/*.generated.vbs
# أي wrapper حي/مثبَّت على جهاز فعلي (machine-specific) — لا يدخل Git أبداً
**/*hidden.vbs
!ozk-print-bridge/install/*.ps1
# Scheduled Task XML export أو أي نسخة منه
*TaskWrapper*.xml
*ScheduledTask*.xml
tasks/*.xml
# نسخ احتياطية لأي حالة/سجل
*.state.bak
*.log.bak

# إعدادات Codex المحلية — تحوي GITHUB_PERSONAL_ACCESS_TOKEN.
# أُدخل هذا الملف سهواً في PR #190 بـ`git add -A` ثم أُزيل. الاستثناء هنا يمنع
# تكراره: أي `add -A` من جذر المستودع كان يبتلعه بلا أن ينتبه أحد.
/.codex/
