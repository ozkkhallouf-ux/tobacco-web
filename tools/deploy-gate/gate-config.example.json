  "writeScan": {
    "_comment": "Static detection of Ameen write capability in changed files (case-insensitive regexes, shared by the release workflow and the gate). A defence in depth only: every script uses a SQL login that can write, so the real control is a read-only login for readers (separate owner decision).",
    "include": "^(tools|scripts)/.+\\.(ps1|psm1|sql|js|mjs|cjs|bat|cmd|vbs|py)$",
    "exclude": [
      "^tools/tests/",
      "/__tests__/",
      "^scripts/check[^/]*\\.mjs$"
    ],
    "patterns": [
      "AMEEN_SQL_WRITE_CONNECTION_STRING",
      "WRITE_CONNECTION",
      "\\binsert\\s+into\\b",
      "\\bupdate\\s+[\\w.\\[\\]]+\\s+set\\b",
      "\\bdelete\\s+from\\b",
      "\\bmerge\\s+into\\b",
      "\\btruncate\\s+table\\b",
      "\\b(drop|alter|create)\\s+(table|view|procedure|proc|function|trigger|index)\\b",
      "\\bexec(ute)?\\s+(sp_|dbo\\.|\\[dbo\\])",
      "ExecuteNonQuery",
      "SqlBulkCopy",
      "\\bbegin\\s+tran",
      "Invoke-Sqlcmd",
      "\\bsqlcmd(\\.exe)?\\b"
    ]
  },
  "longRunningComponents": [
