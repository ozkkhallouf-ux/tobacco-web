logs/
tmp/
tools/logs/
tools/mcp-backups/
*.bak
*.bak[0-9]
*.backup-*
**/*.backup-*

# Sensitive/generated reports
reports/prices/*.csv
reports/daily/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Misc dev tooling not needed at runtime
.serena/
.claude/
.mcp.json
docs/
ios-sideload-lab/
