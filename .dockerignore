# Git / VCS
.git/
.gitattributes
.github/

# Node
node_modules/
npm-debug.log*

# Secrets & environment — never enter the build context
.env
.env.*
!.env.example
tools/.env

# Windows-only automation (Ameen SQL, Task Scheduler) — irrelevant inside Docker
tools/

